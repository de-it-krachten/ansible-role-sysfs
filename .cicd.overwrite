---

# Generic
generic:
  role: ansible-role-sysfs
  role_short: sysfs
  role_description: |
    <basic role description>
  collections: []

# Supported platforms
platforms:
  ubuntu2004:
    supported: true
    ci: true
  fedora42:
    supported: false
    ci: false
  fedora43:
    supported: false
    ci: false

# Molecule
molecule:
  requirements:
    roles_extra: []
  converge:
    vars:
      sysfs_dropin_files:
      - scheduler
